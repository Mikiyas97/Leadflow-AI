# LeadFlow AI Agent - Environment Configuration

# Google Gemini API Key (get from https://aistudio.google.com/)
GEMINI_API_KEY=

# Hunter.io API Key for contact and domain lookup (https://hunter.io)
HUNTER_API_KEY=

# Firecrawl API Key for website content scraping (https://firecrawl.dev)
FIRECRAWL_API_KEY=

# Database Connection (defaults to local SQLite if empty)
# For Supabase / PostgreSQL: postgresql://postgres:password@db.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./leadflow.db

# Frontend origin allowed for CORS
FRONTEND_ORIGIN=http://localhost:5173

# Server Port
PORT=8000
